APP_IMAGE=ghcr.io/your-github-id/sonbadream-server:latest

DB_URL=jdbc:mysql://your-rds-endpoint.ap-northeast-2.rds.amazonaws.com:3306/sonbadream?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&rewriteBatchedStatements=true
DB_USERNAME=sonbadream
DB_PASSWORD=change-me

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
ADMIN_VERIFICATION_PASSWORD_HASH=change-me
ADMIN_VERIFICATION_TOKEN_EXPIRATION=1800000

KAKAO_CLIENT_ID=change-me
FRONTEND_URL=https://www.sonbadream.com

CLOUDFLARE_R2_ACCESS_KEY=change-me
CLOUDFLARE_R2_SECRET_KEY=change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=https://grafana.sonbadream.com
